if(TalkedChasseur == 1 && CycleCount == 0)
	dialog(null;null;Talk_Character_Done_1)
else

	setCharacterAlpha(Chasseur;0;0.5;true)
	setCharacterPosition(Chasseur;Front)
	setCharacterRotation(Chasseur;Front)
	setCharacterAlpha(Chasseur;1;0.5;false)

	switch(CycleCount)
		case default:

		dialog(null;null;Choice_InteractCharacter)
		choice(List)
			choice Choice_Talk:
				if(TalkedChasseur == 1)
					dialog(null;null;Talk_Character_Done_1)
				else

					if(LieToChasseurQuest == 1)
						# Can lie to chasseur
						load(ChasseurLieQuest)
					else
						# Default
						if(CycleCount == 1)
							load(ChasseurC1Default)
						else
							load(ChasseurC2Default)
						endif
					endif

					variable(TalkedChasseur;=;1)
				endif

			choice Choice_Search:
				if(SearchCounter > 0)
					# Search his belongings
					variable(SearchCounter;-;1)
					variable(SecretChasseur;=;1)
					dialog(null;null;Steal_Chasseur_1)
					dialog(null;null;Steal_Chasseur_2)
					load(/VMP/Common/PrintSearchCounter)
				else
					# Cannot search
					dialog(null;null;Counter_Search_0)
				endif

			choice Choice_Nothing:
			# Do Nothing

		endchoice


		case 0:
			# Cycle 0 : Intro
			dialog(Char_Chasseur;null;Talk_Chasseur_Presentation_1)
			dialog(Char_LoupGarou;null;Talk_Chasseur_Presentation_2)
			dialog(Char_Chasseur;null;Talk_Chasseur_Presentation_3)
			dialog(null;null;Talk_Chasseur_Presentation_4)
			variable(TalkedChasseur;=;1)

	endswitch

	setCharacterAlpha(Chasseur;0;0.5;true)
	setCharacterPosition(Chasseur;ChasseurSpot)
	setCharacterRotation(Chasseur;ChasseurSpot)
	setCharacterAlpha(Chasseur;1;0.5;false)

endif

load(/VMP/Common/CycleCheck)

load(Interaction)