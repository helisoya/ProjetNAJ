if(TalkedRival == 1 && CycleCount == 0)
	dialog(null;null;Talk_Character_Done_1)
else

	setCharacterAlpha(Rival;0;0.5;true)
	setCharacterPosition(Rival;Front)
	setCharacterRotation(Rival;Front)
	setCharacterAlpha(Rival;1;0.5;false)

	switch(CycleCount)
		case default:

		dialog(null;null;Choice_InteractCharacter)
		choice(List)
			choice Choice_Talk:
				if(TalkedRival == 1)
					dialog(null;null;Talk_Character_Done_1)
				else

					if(CycleCount == 1)
						if(DrinkQuest == 3 && RivalReactionToDrinkQuest == 0)
							# React OMG Drama
							load(RivalReactionDrinkQuest)
						else
							# Default
							load(RivalC1Default)
						endif
					endif

					if(CycleCount == 2)
						if(PutPressureOnRival == 1)
							# Put pressure on rival quest
							load(RivalPressureQuest)
						else
							# Default
							load(RivalC2Default)
						endif
					endif

					variable(TalkedRival;=;1)
				endif

			choice Choice_Search:
				if(SearchCounter > 0)
					# Search his belongings
					variable(SearchCounter;-;1)
					variable(SecretRival;=;1)
					dialog(null;null;Steal_Rival_1)
					dialog(null;null;Steal_Rival_2)
					load(/VMP/Common/PrintSearchCounter)
				else
					# Cannot search
					dialog(null;null;Counter_Search_0)
				endif

			choice Choice_Nothing:
			# Do Nothing

		endchoice


		case 0:
			# Cycle 0 : Intro
			dialog(Char_Rival;null;Talk_Rival_Presentation_1)
			dialog(Char_LoupGarou;null;Talk_Rival_Presentation_2)
			dialog(Char_Rival;null;Talk_Rival_Presentation_3)
			dialog(null;null;Talk_Rival_Presentation_4)
			variable(TalkedRival;=;1)

	endswitch

	setCharacterAlpha(Rival;0;0.5;true)
	setCharacterPosition(Rival;RivalSpot)
	setCharacterRotation(Rival;RivalSpot)
	setCharacterBody(Rival;Normal)
	setCharacterAlpha(Rival;1;0.5;false)

endif

load(/VMP/Common/CycleCheck)

load(Interaction)