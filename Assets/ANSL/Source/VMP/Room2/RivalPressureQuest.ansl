variable(RivalPressureQuest;=;2)

if(RivalReactionToDrinkQuest == 1)
	# Loyal Baron
	dialog(Char_LoupGarou;null;Talk_Rival_Pressure_LoyalBaron_1)
	dialog(Char_LoupGarou;null;Talk_Rival_Pressure_LoyalBaron_2)
	dialog(Char_LoupGarou;null;Talk_Rival_Pressure_LoyalBaron_3)
	dialog(Char_Rival;null;Talk_Rival_Pressure_LoyalBaron_4)
	dialog(Char_Rival;null;Talk_Rival_Pressure_LoyalBaron_5)
	variable(ValueRival;-;2)
else
	# Loyal Rival
	dialog(Char_LoupGarou;null;Talk_Rival_Pressure_LoyalRival_1)
	dialog(Char_LoupGarou;null;Talk_Rival_Pressure_LoyalRival_2)
	dialog(Char_LoupGarou;null;Talk_Rival_Pressure_LoyalRival_3)
	dialog(Char_Rival;null;Talk_Rival_Pressure_LoyalRival_4)
	variable(ValueRival;+;1)
	load(RivalGetInfosFromFils)
endif