dialog(null;null;Talk_Chasseur_Confirm_Lie_1)

choice(List)
	choice Choice_Yes:
		dialog(Char_LoupGarou;null;Talk_Chasseur_Ours_1)
		dialog(Char_Chasseur;null;Talk_Chasseur_Ours_2)
		dialog(Char_LoupGarou;null;Talk_Chasseur_Ours_3)
		dialog(Char_LoupGarou;null;Talk_Chasseur_Ours_4)
		dialog(Char_LoupGarou;null;Talk_Chasseur_Ours_5)
		dialog(Char_LoupGarou;null;Talk_Chasseur_Ours_6)
		setCharacterBody(Chasseur;Normal)
		dialog(Char_Chasseur;null;Talk_Chasseur_Ours_7)
		variable(LieToChasseurQuest;=;2)
		variable(ValueFils;+;3)
	choice Choice_RevealHisSecret (FilsWeirdQuest == 4):
		dialog(Char_LoupGarou;null;Talk_Chasseur_Fils_1)
		dialog(Char_Chasseur;null;Talk_Chasseur_Fils_2)
		dialog(Char_LoupGarou;null;Talk_Chasseur_Fils_3)
		dialog(Char_LoupGarou;null;Talk_Chasseur_Fils_4)
		setCharacterBody(Chasseur;Normal)
		dialog(Char_Chasseur;null;Talk_Chasseur_Fils_5)
		variable(LieToChasseurQuest;=;3)
		variable(ValueFils;-;3)
		variable(ValueChasseur;+;2)
	choice Choice_NotNow:
		switch(CycleCount)
			case 1:
				load(ChasseurC1Default)
			case 2:
				load(ChasseurC2Default)
		endswitch
			
endchoice