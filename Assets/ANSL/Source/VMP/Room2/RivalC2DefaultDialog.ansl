if(RivalReactionToDrinkQuest == 1)
	dialog(Char_Rival;null;Talk_Rival_LoyalBaron_1)
	dialog(Char_Rival;null;Talk_Rival_LoyalBaron_2)
else
	dialog(Char_Rival;null;Talk_Rival_LateLoyaltyCheck_1)
	dialog(Char_Rival;null;Talk_Rival_LateLoyaltyCheck_2)
	dialog(Char_Rival;null;Talk_Rival_LateLoyaltyCheck_3)

	choice(List)
		choice Choice_Yes:
			dialog(Char_LoupGarou;null;Talk_Rival_LateLoyalRival_1)
			dialog(Char_LoupGarou;null;Talk_Rival_LateLoyalRival_2)
			dialog(Char_LoupGarou;null;Talk_Rival_LateLoyalRival_3)
			dialog(Char_Rival;null;Talk_Rival_LateLoyalRival_4)
			variable(RivalReactionToDrinkQuest;=;2)
			variable(ValueRival;+;2)
		choice Choice_No:
			dialog(Char_LoupGarou;null;Talk_Rival_Centrist_1)
			dialog(Char_LoupGarou;null;Talk_Rival_Centrist_2)
			dialog(Char_Rival;null;Talk_Rival_Centrist_3)
			dialog(Char_Rival;null;Talk_Rival_Centrist_4)
			dialog(Char_Rival;null;Talk_Rival_Centrist_5)
			dialog(Char_Rival;null;Talk_Rival_Centrist_6)
			variable(ValueRival;-;1)
	endchoice
endif




