setCharacterAlpha(Rival;0;0.5;true)
setCharacterAlpha(Baron;1;0.5;false)

dialog(null;null;Scene_End_BaronRival_1)
dialog(Char_Baron;null;Scene_End_BaronRival_2)
dialog(Char_Baron;null;Scene_End_BaronRival_3)
dialog(Char_Baron;null;Scene_End_BaronRival_4)
dialog(Char_Baron;null;Scene_End_BaronRival_5)

setCharacterAlpha(Baron;0;0.5;true)
setCharacterAlpha(Chasseur;1;0.5;false)

