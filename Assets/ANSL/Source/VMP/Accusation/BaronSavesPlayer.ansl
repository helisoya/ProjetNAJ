if(ConfrontedChasseurSecret == 2)
	dialog(null;null;Scene_End_BaronRival_7)
	choice(List)
		choice Choice_BetrayHunter:
			variable(ValueHunter;-;3)
			dialog(Char_LoupGarou;null;Scene_End_AccusationChasseur2_1)
			dialog(Char_LoupGarou;null;Scene_End_AccusationChasseur2_2)

			setCharacterAlpha(Rival;0;0.5;true)
			setCharacterAlpha(Chasseur;1;0.5;false)

			dialog(Char_Chasseur;null;Scene_End_AccusationChasseur2_3)
			dialog(Char_Chasseur;null;Scene_End_AccusationChasseur2_4)
			dialog(Char_Chasseur;null;Scene_End_AccusationChasseur2_5)

			if(FilsWeirdQuest == 3)
				load(FilsAttackChasseur)
			else
				load(BaronSavesFils)
			endif
			return()
		choice Choice_StaySilent:

	endchoice
endif


