# Trial Start / Baron accuse Rival
# Par défaut : Rival accuse Chasseur, Chasseur accuse humain
# Si rival connais secret baron : Rival accuse baron, baron accuse rival, rival accuse joueur

fadeFg(1;true)

removeAllCharacters()

setBackground(Room1)

addCharacter(Baron;false;Front)
addCharacter(Chasseur;true;Front)
addCharacter(Fils;true;Front)
addCharacter(Rival;true;Front)
addCharacter(Humain;true;Front)
setCharacterBody(Baron;Angry)
setCharacterBody(Fils;Angry)
setCharacterBody(Rival;Angry)
setCharacterBody(Humain;Sad)

playMusic(Accusation)

fadeFg(0;false)

setLocation(Location_VMP_Accusation)

autosave()

dialog(Char_Baron;null;Scene_End_Intro_1)
dialog(Char_Baron;null;Scene_End_Intro_2)

setCharacterAlpha(Baron;0;0.5;true)
setCharacterAlpha(Fils;1;0.5;false)

dialog(Char_Fils;null;Scene_End_Intro_3)

setCharacterAlpha(Fils;0;0.5;true)
setCharacterAlpha(Baron;1;0.5;false)

dialog(Char_Baron;null;Scene_End_Intro_4)
dialog(Char_Baron;null;Scene_End_Intro_5)
dialog(null;null;Scene_End_Intro_6)
dialog(Char_Baron;null;Scene_End_Intro_7)
dialog(Char_Baron;null;Scene_End_Intro_8)
dialog(Char_Baron;null;Scene_End_Intro_9)

setCharacterAlpha(Baron;0;0.5;true)
setCharacterAlpha(Rival;1;0.5;false)

if(RivalReactionToDrinkQuest == 2)
	# Rival > Baron > Rival > Joueur

	dialog(Char_Rival;null;Scene_End_RivalBaron_1)
	dialog(Char_Rival;null;Scene_End_RivalBaron_2)
	dialog(Char_Rival;null;Scene_End_RivalBaron_3)
	dialog(Char_Rival;null;Scene_End_RivalBaron_4)
	dialog(Char_Rival;null;Scene_End_RivalBaron_5)

	setCharacterAlpha(Rival;0;0.5;true)
	setCharacterAlpha(Baron;1;0.5;false)

	dialog(Char_Baron;null;Scene_End_RivalBaron_6)
	dialog(Char_Baron;null;Scene_End_RivalBaron_7)
	dialog(Char_Baron;null;Scene_End_RivalBaron_8)
	dialog(Char_Baron;null;Scene_End_RivalBaron_9)
	dialog(Char_Baron;null;Scene_End_RivalBaron_10)

	setCharacterAlpha(Baron;0;0.5;true)
	setCharacterAlpha(Rival;1;0.5;false)

	dialog(Char_Rival;null;Scene_End_RivalBaron_11)
	dialog(null;null;Scene_End_RivalBaron_12)

	dialog(Char_Rival;null;Scene_End_RivalBaron_13)
	dialog(Char_Rival;null;Scene_End_RivalBaron_14)

	dialog(null;null;Scene_End_RivalBaron_15)

	load(PlayerSecretChoice)

else
	# Default
	# Rival > Chasseur > Humain

	dialog(Char_Rival;null;Scene_End_RivalHunter_1)
	dialog(Char_Rival;null;Scene_End_RivalHunter_2)
	dialog(Char_Rival;null;Scene_End_RivalHunter_3)
	dialog(Char_Rival;null;Scene_End_RivalHunter_4)
	dialog(Char_Rival;null;Scene_End_RivalHunter_5)
	dialog(Char_Rival;null;Scene_End_RivalHunter_6)

	setCharacterAlpha(Rival;0;0.5;true)
	setCharacterAlpha(Chasseur;1;0.5;false)

	dialog(Char_Chasseur;null;Scene_End_HunterHuman1_1)
	dialog(Char_Chasseur;null;Scene_End_HunterHuman1_2)
	dialog(Char_Chasseur;null;Scene_End_HunterHuman1_3)
	dialog(Char_Chasseur;null;Scene_End_HunterHuman1_4)

	load(FilsProtectHumain)
endif