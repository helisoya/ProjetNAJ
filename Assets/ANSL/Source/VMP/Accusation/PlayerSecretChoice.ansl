if(ConfrontedHumainSecret != 0 && ConfrontedChasseurSecret == 2 && SecretFils == 1)

	choice(List)
		choice Choice_BetrayHunter (ConfrontedChasseurSecret == 2):
			dialog(Char_LoupGarou;null;Scene_End_AccusationChasseur1_1)
			dialog(Char_LoupGarou;null;Scene_End_AccusationChasseur1_2)
			dialog(Char_LoupGarou;null;Scene_End_AccusationChasseur1_3)
			variable(ValueHunter;-;3)
			variable(AttackedSame1;=;1)

			setCharacterAlpha(Rival;0;0.5;true)
			setCharacterAlpha(Chasseur;1;0.5;false)

			dialog(Char_Chasseur;null;Scene_End_AccusationChasseur1_4)
			dialog(Char_Chasseur;null;Scene_End_AccusationChasseur1_5)
			dialog(Char_Chasseur;null;Scene_End_AccusationChasseur1_6)	
			load(FilsProtectHumain)
			return()
		choice Choice_BetrayHumain (ConfrontedHumainSecret != 0):
			dialog(Char_LoupGarou;null;Scene_End_AccusationHumain_1)
			dialog(Char_LoupGarou;null;Scene_End_AccusationHumain_2)
			dialog(Char_LoupGarou;null;Scene_End_AccusationHumain_3)

			setCharacterAlpha(Rival;0;0.5;true)
			setCharacterAlpha(Fils;1;0.5;false)

			dialog(Char_Fils;null;Scene_End_FilsChasseur2_1)
			dialog(Char_Fils;null;Scene_End_FilsChasseur2_2)
			dialog(Char_Fils;null;Scene_End_FilsChasseur2_3)
			dialog(Char_Fils;null;Scene_End_FilsChasseur2_4)

			variable(ValueHumain;-;3)
			variable(ValueFils;-;3)
			variable(AttackedSame1;=;2)
			load(FilsChasseurTop)
			return()
		choice Choice_BetrayFils (SecretFils == 1):
			dialog(Char_LoupGarou;null;Scene_End_AccusationFils_1)
			dialog(Char_LoupGarou;null;Scene_End_AccusationFils_2)
			dialog(Char_LoupGarou;null;Scene_End_AccusationFils_3)
			dialog(Char_LoupGarou;null;Scene_End_AccusationFils_4)
			dialog(Char_LoupGarou;null;Scene_End_AccusationFils_5)
			variable(ValueFils;-;3)
			load(FilsAttackChasseur)
			return()

		choice Choice_StaySilent:
			dialog(Char_LoupGarou;null;Scene_End_NoBetrayal_1)
	endchoice
else
	dialog(Char_LoupGarou;null;Scene_End_NoTea_1)
endif	


if(ValueBaron < 3)
	# Dead
	dialog(Char_Rival;null;Scene_End_Lose_1)
	dialog(Char_LoupGarou;null;Scene_End_Lose_2)
	dialog(Char_Rival;null;Scene_End_Lose_3)

	load(/VMP/Endings/PlayerNoSecrets)
else
	load(BaronSavesPlayer)
endif