if(LookCounter > 0)
variable(LookCounter;-;1)

if(ConfrontedChasseurSecret == 2)
	dialog(null;null;Watch_Boris_Keys_1)
	dialog(null;null;Watch_Boris_Keys_2)
	dialog(null;null;Watch_Boris_Keys_3)

	choice(List)
		choice Choice_Yes:
			load(/VMP/Endings/StoleKeyBackEnding)
		choice Choice_No:
			dialog(null;null;Watch_Boris_Keys_4)
	endchoice
endif




switch(BorisCounter)
case 0:
	dialog(null;null;Watch_Boris_1)
	variable(BorisCounter;+;1)
case 1:
	dialog(null;null;Watch_Boris_2)
	variable(BorisCounter;+;1)
case 2:
	dialog(null;null;Watch_Boris_3)
	variable(BorisCounter;+;1)
case 3:
	dialog(null;null;Watch_Boris_4)
	variable(BorisCounter;+;1)
case 4:
	dialog(null;null;Watch_Boris_5)
	variable(BorisCounter;+;1)

case 5:
	if(ConfrontedChasseurSecret == 2)
		# No Boris Interaction if you know the chasseur's secret
		return()
	endif

	setStaticAlpha(BorisScene;0;0.5;true)
	setStaticAlpha(Boris;1;0.5;false)

	# You can legally address the skeleton in the room
	if(DrinkQuest == 2)
		# Give drink to boris
		# Not possible under normal circumstances
	else
		# Boris is thirsty
		dialog(Char_Boris;null;Talk_Boris_Presentation_1)
		dialog(Char_Boris;null;Talk_Boris_Presentation_2)
		dialog(Char_Boris;null;Talk_Boris_Presentation_3)
		dialog(Char_Boris;null;Talk_Boris_Presentation_4)
		dialog(Char_Boris;null;Talk_Boris_Presentation_5)
		dialog(Char_Boris;null;Talk_Boris_Presentation_6)
		dialog(Char_Boris;null;Talk_Boris_Presentation_7)
	endif

	setStaticAlpha(Boris;0;0.5;true)
	setStaticAlpha(BorisScene;1;0.5;false)
	
endswitch

load(/VMP/Common/PrintLookCounter)
else
dialog(null;null;Counter_Look_0)
endif

load(/VMP/Common/CycleCheck)

load(Interaction)