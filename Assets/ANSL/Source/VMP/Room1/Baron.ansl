if(TalkedBaron == 1 && CycleCount == 0)
	dialog(null;null;Talk_Character_Done_1)
else

	setCharacterAlpha(Baron;0;0.5;true)
	setCharacterPosition(Baron;Front)
	setCharacterRotation(Baron;Front)
	setCharacterAlpha(Baron;1;0.5;false)

	switch(CycleCount)
		case default:

		dialog(null;null;Choice_InteractCharacter)
		choice(List)
			choice Choice_Talk:
				if(TalkedBaron == 1)
					dialog(null;null;Talk_Character_Done_1)
				else

					if(DrinkQuest == 3 && CycleCount == 2)
						# Fils Check Quest Result
						if(FilsWeirdQuest == 4)
							load(BaronFilsQuestWeirdGood)
						else
							load(BaronFilsQuestWeirdNeutral)
						endif
					endif


					if(DrinkQuest == 2 && CycleCount == 1)
						# Drink Quest done in time
						load(BaronDrinkQuestOnTime)
					endif

					if(DrinkQuest == 2 && CycleCount == 2)
						# Drink Quest done late
						load(BaronDrinkQuestLate)
					endif

					if(DrinkQuest < 2 && CycleCount == 2)
						# Drink Quest failed (Nothing at cycle 2)
						load(BaronDrinkQuestFail)
					endif

					if(DrinkQuest < 2 && CycleCount == 1)
						# Drink Quest not started (But still OK)
						load(BaronDrinkQuestC1No)
					endif

					variable(TalkedBaron;=;1)
				endif

			choice Choice_Search:
				if(SearchCounter > 0)
					# Search his belongings
					variable(SearchCounter;-;1)
					variable(SecretBaron;=;1)
					dialog(null;null;Steal_Baron_1)
					dialog(null;null;Steal_Baron_2)
					load(/VMP/Common/PrintSearchCounter)
				else
					# Cannot search
					dialog(null;null;Counter_Search_0)
				endif

			choice Choice_Nothing:
			# Do Nothing

		endchoice


		case 0:
			# Cycle 0 : Intro
			dialog(Char_Baron;null;Talk_Baron_Presentation_1)
			dialog(Char_Baron;null;Talk_Baron_Presentation_2)
			dialog(null;null;Talk_Baron_Presentation_3)
			dialog(Char_LoupGarou;null;Talk_Baron_Presentation_4)

			variable(DrinkQuest;=;1)
			variable(TalkedBaron;=;1)

	endswitch

	setCharacterAlpha(Baron;0;0.5;true)
	setCharacterPosition(Baron;BaronSpot)
	setCharacterRotation(Baron;BaronSpot)
	setCharacterBody(Baron;Normal)
	setCharacterAlpha(Baron;1;0.5;false)

endif

load(/VMP/Common/CycleCheck)

load(Interaction)