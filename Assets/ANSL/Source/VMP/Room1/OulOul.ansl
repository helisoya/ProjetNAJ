if(LookCounter > 0)
variable(LookCounter;-;1)

setCharacterPosition(OulOul;Front)
setCharacterRotation(OulOul;Front)

wait(2)

setCharacterPosition(OulOul;OulOulSpot)
setCharacterRotation(OulOul;OulOulSpot)

load(/VMP/Common/PrintLookCounter)
else
dialog(null;null;Counter_Look_0)
endif

load(/VMP/Common/CycleCheck)

load(Interaction)