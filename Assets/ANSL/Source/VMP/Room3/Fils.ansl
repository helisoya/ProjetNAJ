if(TalkedFils == 1 && CycleCount == 0)
	dialog(null;null;Talk_Character_Done_1)
else

	setCharacterAlpha(Fils;0;0.5;true)
	setCharacterPosition(Fils;Front)
	setCharacterRotation(Fils;Front)
	setCharacterAlpha(Fils;1;0.5;false)

	switch(CycleCount)
		case default:

		dialog(null;null;Choice_InteractCharacter)
		choice(List)
			choice Choice_Talk:
				if(TalkedFils == 1)
					dialog(null;null;Talk_Character_Done_1)
				else

					if(CycleCount == 1)
						if(FilsWeirdQuest == 1)
							# Fils is weird quest
							dialog(null;null;Talk_Fils_Ask_Check_1)
							choice(List)
								choice Choice_Yes:
									load(FilsC1Confront)
								choice Choice_No:
									load(FilsC1DefaultDialog)
							endchoice

						else
							# Has not started the Fils Weird Quest
							load(FilsC1DefaultDialog)
						endif
					endif

					if(CycleCount == 2)
						if(GetInfosFromFilsQuest == 1)
							# Fils is weird quest
							dialog(null;null;Fils_ConfrontRivalInfos_0)
							choice(List)
								choice Choice_Yes:
									load(FilsRivalInfosConfront)
								choice Choice_No:
									load(FilsC2DefaultDialog)
							endchoice

						else
							# Has not started the Fils Weird Quest
							load(FilsC2DefaultDialog)
						endif
					endif		

					variable(TalkedFils;=;1)
				endif

			choice Choice_Search:
				if(SearchCounter > 0)
					# Search his belongings
					variable(SearchCounter;-;1)
					variable(SecretFils;=;1)
					dialog(null;null;Steal_Fils_1)
					dialog(null;null;Steal_Fils_2)
					load(/VMP/Common/PrintSearchCounter)
				else
					# Cannot search
					dialog(null;null;Counter_Search_0)
				endif

			choice Choice_Nothing:
			# Do Nothing

		endchoice


		case 0:
			# Cycle 0 : Intro
			dialog(Char_Fils;null;Talk_Fils_Presentation_1)
			dialog(Char_LoupGarou;null;Talk_Fils_Presentation_2)
			dialog(null;null;Talk_Fils_Presentation_3)
			dialog(Char_Fils;null;Talk_Fils_Presentation_4)
			variable(TalkedFils;=;1)

	endswitch

	setCharacterAlpha(Fils;0;0.5;true)
	setCharacterPosition(Fils;FilsSpot)
	setCharacterRotation(Fils;FilsSpot)
	setCharacterBody(Fils;Normal)
	setCharacterAlpha(Fils;1;0.5;false)

endif

load(/VMP/Common/CycleCheck)

load(Interaction)