if(TalkedHumain == 1 && CycleCount == 0)
	dialog(null;null;Talk_Character_Done_1)
else

	setCharacterAlpha(Humain;0;0.5;true)
	setCharacterPosition(Humain;Front)
	setCharacterRotation(Humain;Front)
	setCharacterAlpha(Humain;1;0.5;false)

	switch(CycleCount)
		case default:

		dialog(null;null;Choice_InteractCharacter)
		choice(List)
			choice Choice_Talk:
				if(TalkedHumain == 1)
					dialog(null;null;Talk_Character_Done_1)
				else

					if(SecretHumain == 1 && ConfrontedHumainSecret == 0)
						# Know the secret
						dialog(null;null;Talk_Humain_Confirm_Confront_1)
						choice(List)
							choice Choice_Yes:
								load(HumainSecret)
							choice Choice_No:
								if(CycleCount == 1)
									load(HumainC1Default)
								else
									load(HumainC2Default)
								endif
						endchoice

					else
						# Has not found his secret
						if(CycleCount == 1)
							load(HumainC1Default)
						else
							load(HumainC2Default)
						endif
					endif

					variable(TalkedHumain;=;1)
				endif

			choice Choice_Search:
				if(SearchCounter > 0)
					# Search his belongings
					variable(SearchCounter;-;1)
					variable(SecretHumain;=;1)
					dialog(null;null;Steal_Humain_1)
					dialog(null;null;Steal_Humain_2)
					load(/VMP/Common/PrintSearchCounter)
				else
					# Cannot search
					dialog(null;null;Counter_Search_0)
				endif

			choice Choice_Nothing:
			# Do Nothing

		endchoice


		case 0:
			# Cycle 0 : Intro
			dialog(Char_Humain;null;Talk_Humain_Presentation_1)
			dialog(Char_LoupGarou;null;Talk_Humain_Presentation_2)
			dialog(Char_Humain;null;Talk_Humain_Presentation_3)
			dialog(null;null;Talk_Humain_Presentation_4)
			variable(TalkedHumain;=;1)

	endswitch

	setCharacterAlpha(Humain;0;0.5;true)
	setCharacterPosition(Humain;HumainSpot)
	setCharacterRotation(Humain;HumainSpot)
	setCharacterBody(Humain;Normal)
	setCharacterAlpha(Humain;1;0.5;false)

endif

load(/VMP/Common/CycleCheck)

load(Interaction)