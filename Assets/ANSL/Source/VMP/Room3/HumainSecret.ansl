variable(ConfrontedHumainSecret;=;1)

dialog(null;null;Humain_Secret_1)
dialog(Char_Humain;null;Humain_Secret_2)
dialog(Char_Humain;null;Humain_Secret_3)
dialog(null;null;Humain_Secret_4)
dialog(Char_Humain;null;Humain_Secret_5)

setCharacterAlpha(Fils;0;0.5;false)
setCharacterAlpha(Humain;0;0.5;true)

setCharacterPosition(Fils;Front)
setCharacterRotation(Fils;Front)

setCharacterPosition(Humain;HumainSpot)
setCharacterRotation(Humain;HumainSpot)

setCharacterAlpha(Fils;1;0.5;false)
setCharacterAlpha(Humain;1;0.5;false)

if(ValueFils <= 0)
	# Ennemy response
	dialog(Char_Fils;null;Humain_Secret_Ennemy_1)
	dialog(Char_Fils;null;Humain_Secret_Ennemy_2)
	variable(ValueFils;-;1)
	variable(ValueHumain;-;1)
else 
if(ValueFils < 3)
	# neutral response
	dialog(Char_Fils;null;Humain_Secret_Neutral_1)
	dialog(Char_Fils;null;Humain_Secret_Neutral_2)
else 
	# ally response
	dialog(Char_Fils;null;Humain_Secret_Ally_1)
	dialog(Char_Fils;null;Humain_Secret_Ally_2)
	dialog(null;null;Humain_Secret_Ally_3)
	variable(ValueHumain;+;1)
endif
endif

setCharacterAlpha(Fils;0;0.5;true)
setCharacterPosition(Fils;FilsSpot)
setCharacterRotation(Fils;FilsSpot)
setCharacterAlpha(Fils;1;0.5;false)