variable(ConfrontedHumainSecret;=;1)

dialog(Char_LoupGarou;null;Talk_Humain_Clue_1)
dialog(Char_LoupGarou;null;Talk_Humain_Clue_2)
dialog(Char_LoupGarou;null;Talk_Humain_Clue_3)

if(ValueFils <= 0)
	# Ennemy response
	setCharacterAlpha(Fils;0;0.5;false)
	setCharacterAlpha(Humain;0;0.5;true)

	setCharacterPosition(Fils;Front)
	setCharacterRotation(Fils;Front)
	setCharacterBody(Fils;Angry)

	setCharacterPosition(Humain;HumainSpot)
	setCharacterRotation(Humain;HumainSpot)

	setCharacterAlpha(Fils;1;0.5;false)
	setCharacterAlpha(Humain;1;0.5;false)

	dialog(Char_Fils;null;Talk_Humain_Stop_1)
	dialog(Char_Fils;null;Talk_Humain_Stop_2)
	dialog(Char_Fils;null;Talk_Humain_Stop_3)
	dialog(Char_Fils;null;Talk_Humain_Stop_4)
	variable(ValueFils;-;1)
	variable(ValueHumain;-;1)
else 
if(ValueFils < 3)
	# neutral response

	dialog(Char_Humain;null;Talk_Humain_Excuse_1)

	setCharacterAlpha(Fils;0;0.5;false)
	setCharacterAlpha(Humain;0;0.5;true)

	setCharacterPosition(Fils;Front)
	setCharacterRotation(Fils;Front)

	setCharacterPosition(Humain;HumainSpot)
	setCharacterRotation(Humain;HumainSpot)

	setCharacterAlpha(Fils;1;0.5;false)
	setCharacterAlpha(Humain;1;0.5;false)

	dialog(Char_Fils;null;Talk_Humain_Excuse_2)
	dialog(Char_Fils;null;Talk_Humain_Excuse_3)
	dialog(Char_Fils;null;Talk_Humain_Excuse_4)
	dialog(Char_Fils;null;Talk_Humain_Excuse_5)
	dialog(Char_Fils;null;Talk_Humain_Excuse_6)
	dialog(Char_Humain;null;Talk_Humain_Excuse_7)
	dialog(Char_Fils;null;Talk_Humain_Excuse_8)
	dialog(Char_LoupGarou;null;Talk_Humain_Excuse_9)
else 
	# ally response

	dialog(Char_Humain;null;Talk_Humain_Secret_1)
	dialog(Char_LoupGarou;null;Talk_Humain_Secret_2)
	dialog(null;null;Talk_Humain_Secret_3)


	setCharacterAlpha(Fils;0;0.5;false)
	setCharacterAlpha(Humain;0;0.5;true)

	setCharacterPosition(Fils;Front)
	setCharacterRotation(Fils;Front)

	setCharacterPosition(Humain;HumainSpot)
	setCharacterRotation(Humain;HumainSpot)

	setCharacterAlpha(Fils;1;0.5;false)
	setCharacterAlpha(Humain;1;0.5;false)

	dialog(Char_Fils;null;Talk_Humain_Secret_4)
	dialog(null;null;Talk_Humain_Secret_5)
	dialog(Char_Fils;null;Talk_Humain_Secret_6)
	dialog(null;null;Talk_Humain_Secret_7)
	dialog(Char_LoupGarou;null;Talk_Humain_Secret_8)
	dialog(Char_Fils;null;Talk_Humain_Secret_9)
	dialog(Char_Fils;null;Talk_Humain_Secret_10)
	dialog(null;null;Talk_Humain_Secret_11)
	dialog(Char_Fils;null;Talk_Humain_Secret_12)
	dialog(Char_Fils;null;Talk_Humain_Secret_13)
	dialog(Char_Fils;null;Talk_Humain_Secret_14)
	
	variable(ValueHumain;+;1)
endif
endif

setCharacterAlpha(Fils;0;0.5;true)
setCharacterPosition(Fils;FilsSpot)
setCharacterRotation(Fils;FilsSpot)
setCharacterAlpha(Fils;1;0.5;false)