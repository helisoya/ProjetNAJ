dialog(Char_LoupGarou;null;Talk_Fils_Ask_1)
dialog(Char_Fils;null;Talk_Fils_Ask_2)
dialog(Char_LoupGarou;null;Talk_Fils_Ask_3)
dialog(Char_Fils;null;Talk_Fils_Ask_4)
dialog(Char_LoupGarou;null;Talk_Fils_Ask_5)
dialog(Char_Fils;null;Talk_Fils_Ask_6)
dialog(null;null;Talk_Fils_Ask_7)

variable(ValueFils;-;1)

if(SecretFils == 1)
	dialog(Char_LoupGarou;null;Talk_Fils_Clue_1)

	choice(List)
		choice Choice_ReprimendHim:
			dialog(Char_LoupGarou;null;Talk_Fils_Confront_1)
			dialog(Char_Fils;null;Talk_Fils_Confront_2)
			dialog(Char_Fils;null;Talk_Fils_Confront_3)
			variable(FilsWeirdQuest;=;3)
			variable(ValueFils;-;3)
			variable(ValueBaron;+;2)
		choice Choice_ItsCool:
			dialog(Char_LoupGarou;null;Talk_Fils_Nice_1)
			dialog(Char_LoupGarou;null;Talk_Fils_Nice_2)
			dialog(Char_Fils;null;Talk_Fils_Nice_3)
			dialog(Char_Fils;null;Talk_Fils_Nice_4)
			dialog(Char_Fils;null;Talk_Fils_Nice_5)
			dialog(Char_Fils;null;Talk_Fils_Nice_6)
			dialog(Char_Fils;null;Talk_Fils_Nice_7)
			dialog(Char_Fils;null;Talk_Fils_Nice_8)
			variable(FilsWeirdQuest;=;4)
			variable(ValueFils;+;3)
			variable(LieToChasseurQuest;=;1)
	endchoice

else
	variable(FilsWeirdQuest;=;2)
endif