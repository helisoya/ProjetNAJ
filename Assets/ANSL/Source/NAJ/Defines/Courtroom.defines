# Common Courtroom defines

# Animations

Define playJudgeHammerAnimationOnly()
showDialogWindow(false)
setCameraPosition(HammerCam)
setCameraRotation(HammerCam)
setCharacterBody(Judge;Strike)
wait(1)
EndDefine

Define playJudgeHammerAnimation(NextJudgeBody;NextCam)
showDialogWindow(false)
setCameraPosition(HammerCam)
setCameraRotation(HammerCam)
setCharacterBody(Judge;Strike)
wait(1)
setCharacterBody(Judge;{NextJudgeBody})
setCameraRotation({NextCam})
setCameraPosition({NextCam})
EndDefine

# Camera

Define setCourtroomCamToLobby()
setCameraPosition(LobbyCam)
setCameraRotation(LobbyCam)
EndDefine

Define setCourtroomCamToAll()
setCameraPosition(AllCam)
setCameraRotation(AllCam)
EndDefine

Define setCourtroomCamToHammer()
setCameraPosition(HammerCam)
setCameraRotation(HammerCam)
EndDefine

Define setCourtroomCamToJudge()
setCameraPosition(JudgeCam)
setCameraRotation(JudgeCam)
EndDefine

Define setCourtroomCamToDefenseImmediate()
setCameraPosition(DefenseCam)
setCameraRotation(DefenseCam)
EndDefine

Define setCourtroomCamToDefense(WaitForEnd)
setCameraRotation(DefenseCam;0.25;false)
setCameraPosition(DefenseCam;0.25;{WaitForEnd})
EndDefine

Define setCourtroomCamToProsecutorImmediate()
setCameraRotation(ProsecutionCam)
setCameraPosition(ProsecutionCam)
EndDefine

Define setCourtroomCamToProsecutor(WaitForEnd)
setCameraRotation(ProsecutionCam;0.25;false)
setCameraPosition(ProsecutionCam;0.25;{WaitForEnd})
EndDefine

Define setCourtroomCamToWitnessImmediate()
setCameraRotation(WitnessCam)
setCameraPosition(WitnessCam)
EndDefine

Define setCourtroomCamToWitness(WaitForEnd)
setCameraRotation(WitnessCam;0.25;false)
setCameraPosition(WitnessCam;0.25;{WaitForEnd})
EndDefine

Define setCourtroomCamToWitnessLeftImmediate()
setCameraRotation(WitnessLeftCam)
setCameraPosition(WitnessLeftCam)
EndDefine

Define setCourtroomCamToWitnessLeft(WaitForEnd)
setCameraRotation(WitnessLeftCam;0.25;false)
setCameraPosition(WitnessLeftCam;0.25;{WaitForEnd})
EndDefine

Define setCourtroomCamToWitnessRightImmediate()
setCameraRotation(WitnessRightCam)
setCameraPosition(WitnessRightCam)
EndDefine

Define setCourtroomCamToWitnessRight(WaitForEnd)
setCameraRotation(WitnessRightCam;0.25;false)
setCameraPosition(WitnessRightCam;0.25;{WaitForEnd})
EndDefine