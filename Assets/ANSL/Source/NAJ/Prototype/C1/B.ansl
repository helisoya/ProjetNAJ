removeAllCharacters()

setBackground(Courtroom)

addCharacter(Sherif;false;ProsecutorSpot)
addCharacter(Juno;false;WitnessSpot)
addCharacter(JudgeTurtle;false;DefenseSpot)
addCharacter(Judge;false;JudgeSpot)

addProfile(C1_Judge)

setCameraPosition(JudgeCam)
setCameraRotation(JudgeCam)

fadeFg(0;false)

dialog(Prototype_Judge;Judge;Prototype_B_1)

setCameraPosition(DefenseCam)
setCameraRotation(DefenseCam)
setCharacterBody(JudgeTurtle;InShell;0.5)
dialog(Prototype_Rann;null;Prototype_B_2)

setCameraPosition(ProsecutionCam;0.5;false)
setCameraRotation(ProsecutionCam;0.5;true)
setCharacterBody(JudgeTurtle;Normal;0.5)
dialog(Prototype_Sherif;Sherif;Prototype_B_3)

setCameraPosition(JudgeCam)
setCameraRotation(JudgeCam)
dialog(Prototype_Judge;Judge;Prototype_B_4)

setCameraPosition(ProsecutionCam)
setCameraRotation(ProsecutionCam)
dialog(Prototype_Sherif;Sherif;Prototype_B_5)
dialog(Prototype_Sherif;Sherif;Prototype_B_6)

addEvidence(C1_AutopsyReport)
showEvidenceInfo(Evidence/C1_AutopsyReport;Full)
dialog(null;null;Prototype_B_7)
hideEvidenceInfo()

dialog(Prototype_Sherif;Sherif;Prototype_B_8)

setCameraPosition(WitnessCam;0.5;false)
setCameraRotation(WitnessCam;0.5;true)
addProfile(C1_Juno)
dialog(Prototype_Juno;Juno;Prototype_B_9)

setCameraPosition(JudgeCam)
setCameraRotation(JudgeCam)
dialog(Prototype_Judge;Judge;Prototype_B_10)

setCameraPosition(WitnessCam)
setCameraRotation(WitnessCam)
dialog(Prototype_Juno;Juno;Prototype_B_11)
dialog(Prototype_Juno;Juno;Prototype_B_12)

fadeFg(1;true)
wait(1)
fadeFg(0;false)

clearExaminationData()

examination

part 1
dialog(Prototype_Juno;Juno;Prototype_E1_1;false;noInput)
press 1
setCameraPosition(DefenseCam;0.5;false)
setCameraRotation(DefenseCam;0.5;true)
dialog(Prototype_Rann;null;Prototype_E1_1_Press_1)

setCameraPosition(WitnessCam;0.5;false)
setCameraRotation(WitnessCam;0.5;true)
dialog(Prototype_Juno;Juno;Prototype_E1_1_Press_2)
dialog(Prototype_Juno;Juno;Prototype_E1_1_Press_3)

setCameraPosition(DefenseCam;0.5;false)
setCameraRotation(DefenseCam;0.5;true)
dialog(Prototype_Rann;null;Prototype_E1_1_Press_4)

fadeFg(1;true)
setCameraPosition(WitnessCam)
setCameraRotation(WitnessCam)
fadeFg(0;false)

part 2
dialog(Prototype_Juno;Juno;Prototype_E1_2;false;noInput)
press 2
setCameraPosition(DefenseCam;0.5;false)
setCameraRotation(DefenseCam;0.5;true)
dialog(Prototype_Rann;null;Prototype_E1_2_Press_1)

setCameraPosition(WitnessCam;0.5;false)
setCameraRotation(WitnessCam;0.5;true)
dialog(Prototype_Juno;Juno;Prototype_E1_2_Press_2)

setCameraPosition(ProsecutionCam;0.5;false)
setCameraRotation(ProsecutionCam;0.5;true)
dialog(Prototype_Sherif;Sherif;Prototype_E1_2_Press_3)

fadeFg(1;true)
setCameraPosition(WitnessCam)
setCameraRotation(WitnessCam)
fadeFg(0;false)


part 3 present Evidence/C1_Injury
dialog(Prototype_Juno;Juno;Prototype_E1_3;false;noInput)
press 3
setCameraPosition(DefenseCam;0.5;false)
setCameraRotation(DefenseCam;0.5;true)
dialog(Prototype_Rann;null;Prototype_E1_3_Press_1)

setCameraPosition(WitnessCam;0.5;false)
setCameraRotation(WitnessCam;0.5;true)
dialog(Prototype_Juno;Juno;Prototype_E1_3_Press_2)

fadeFg(1;true)
setCameraPosition(WitnessCam)
setCameraRotation(WitnessCam)
fadeFg(0;false)


fail
setCameraPosition(DefenseCam;0.5;false)
setCameraRotation(DefenseCam;0.5;true)
dialog(Prototype_Rann;null;Prototype_E_Fail_1)

setCameraPosition(JudgeCam)
setCameraRotation(JudgeCam)
dialog(Prototype_Judge;Judge;Prototype_E_Fail_2)
dialog(Prototype_Judge;Judge;Prototype_E_Fail_3)

setCameraPosition(DefenseCam)
setCameraRotation(DefenseCam)
dialog(Prototype_Rann;null;Prototype_E_Fail_4)

fadeFg(1;true)
setCameraPosition(WitnessCam)
setCameraRotation(WitnessCam)
fadeFg(0;false)

loop
fadeFg(1;true)
setCameraPosition(DefenseCam)
setCameraRotation(DefenseCam)
fadeFg(0;false)

dialog(Prototype_Rann;null;Prototype_E1_Loop_1)
dialog(Prototype_Rann;null;Prototype_E1_Loop_2)

fadeFg(1;true)
setCameraPosition(WitnessCam)
setCameraRotation(WitnessCam)
fadeFg(0;false)

endexamination

load(C)