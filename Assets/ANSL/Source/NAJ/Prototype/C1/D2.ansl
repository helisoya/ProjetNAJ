choice(List)
choice Prototype_Q1_Me:
	setCameraPosition(JudgeCam)
	setCameraRotation(JudgeCam)
	dialog(Prototype_Judge;Judge;Prototype_Q1_Me_1)

	setCameraPosition(DefenseCam)
	setCameraRotation(DefenseCam)
	dialog(Prototype_Rann;null;Prototype_Q1_Me_2)

	load(D2)
