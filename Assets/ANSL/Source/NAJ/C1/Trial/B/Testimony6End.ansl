fadeBg(0;false)

examination

part 1
	# Look, the captain and I, we go way back.
	dialog(Char_Gerald;GeraldNoCoat;C1_Trial_Testimony6_Testimony_1;false;noInput)
press 1
	showDialogWindow(false)
