examination

part 1
	# Look, the captain and I, we go way back.
	dialog(Char_Gerald;GeraldNoCoat;C1_Trial_Testimony6_Testimony_1;false;true)
press 1
	showDialogWindow(false)
	playUIAnimation(Press;true)
	
	:setCourtroomCamToDefense(true)
	dialog(Char_Rann;RannCoat;C1_Trial_Testimony6_Press1_1)
	showDialogWindow(false)

	:setCourtroomCamToWitness(true)
	dialog(Char_Gerald;GeraldNoCoat;C1_Trial_Testimony6_Press1_2)
	dialog(Char_Gerald;GeraldNoCoat;C1_Trial_Testimony6_Press1_3)

	:setCourtroomCamToDefenseImmediate()
	dialog(null;null;C1_Trial_Testimony6_Press1_4)

	:setCourtroomCamToJudge()
	dialog(Char_Judge;Judge;C1_Trial_Testimony6_Press1_5)
	showDialogWindow(false)

	fadeBg(1;true)
	:setCourtroomCamToWitnessImmediate()
	fadeBg(0;false)

part 2
	# He once helped me out of a precarious situation.
	dialog(Char_Gerald;GeraldNoCoat;C1_Trial_Testimony6_Testimony_2;false;true)
press 2
	showDialogWindow(false)
	playUIAnimation(Press;true)
	
	:setCourtroomCamToDefense(true)
	dialog(Char_Rann;RannCoat;C1_Trial_Testimony6_Press2_1)
	showDialogWindow(false)

	:setCourtroomCamToWitness(true)
	dialog(Char_Gerald;GeraldNoCoat;C1_Trial_Testimony6_Press2_2)

	:setRannEyeOops(Coat)
