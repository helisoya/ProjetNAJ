	:setCourtroomCamToJudge()
	:setGeraldNormal(NoCoat)
	dialog(Char_Judge;Judge;C1_Trial_Testimony6_Press2_11)

	load(Testimony6End)

part 4
	# I decided to pay him back by joining his crew.
	dialog(Char_Gerald;GeraldNoCoat;C1_Trial_Testimony6_Testimony_4;false;true)
press 4
	showDialogWindow(false)
