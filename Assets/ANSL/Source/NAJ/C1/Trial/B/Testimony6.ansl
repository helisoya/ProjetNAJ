	:setCourtroomCamToJudge()
	dialog(Char_Judge;Judge;C1_Trial_Testimony6_Press2_3)

	:setGeraldOnBar(NoCoat)
	:setCourtroomCamToDefenseImmediate()
	dialog(Char_Rann;RannCoat;C1_Trial_Testimony6_Press2_4)
	
	screenshake(0.1;0.2)
	:setCourtroomCamToWitnessImmediate()
	:setRannEyeNeutral(Coat)
	:setRannNormal(Coat)
	dialog(Char_Gerald;GeraldNoCoat;C1_Trial_Testimony6_Press2_5)

