:setRannNormal(Coat)
:setRannEyeNeutral(Coat)

dialog(Char_Rann;RannCoat;C1_Trial_Testimony5_Press3_32)

ask(Profile)

case Profile/C1_Gerald:
	dialog(Char_Rann;RannCoat;C1_Trial_Testimony5_Press3_34)
	showDialogWindow(false)

	playSFX(Damage)
	screenshake(0.1;0.2)
	:setGeraldEyeSurprise(NoCoat)
	:setGeraldSurprise(NoCoat)
	:setCourtroomCamToWitness(true)
	dialog(Char_Gerald;GeraldNoCoat;C1_Trial_Testimony5_Press3_35)

	:setRobertRelaxed()
	:setRobertEyeThinking()
	:setCourtroomCamToJudge()
	dialog(Char_Judge;Judge;C1_Trial_Testimony5_Press3_36)

	:setCourtroomCamToProsecutorImmediate()
	dialog(Char_Robert;Robert;C1_Trial_Testimony5_Press3_37)
	dialog(Char_Robert;Robert;C1_Trial_Testimony5_Press3_38)
	dialog(Char_Robert;Robert;C1_Trial_Testimony5_Press3_39)
	showDialogWindow(false)

	playSFX(Damage)
	screenshake(0.1;0.2)
	:setCourtroomCamToWitness(true)
	dialog(Char_Gerald;GeraldNoCoat;C1_Trial_Testimony5_Press3_40)

	:setGeraldOnBar(NoCoat)
	dialog(Char_Gerald;GeraldNoCoat;C1_Trial_Testimony5_Press3_41)
	dialog(Char_Gerald;GeraldNoCoat;C1_Trial_Testimony5_Press3_42)
	showDialogWindow(false)

	:setRannAngry(Coat)
	:setCourtroomCamToDefense(true)
	dialog(Char_Rann;RannCoat;C1_Trial_Testimony5_Press3_43)

	:setGeraldThinking(NoCoat)
	:setGeraldEyeSerious(NoCoat)
	:setJudgeEyeThinking()
	:playJudgeHammerAnimation(Normal;JudgeCam)
	dialog(Char_Judge;Judge;C1_Trial_Testimony5_Press3_44)

	:setJudgeEyeNormal()
	dialog(Char_Judge;Judge;C1_Trial_Testimony5_Press3_45)

	:setRobertEyeNormal()
	:setRobertNormal()
	:setCourtroomCamToWitnessImmediate()
	dialog(Char_Gerald;GeraldNoCoat;C1_Trial_Testimony5_Press3_46)
	showDialogWindow(false)

	:setCourtroomCamToProsecutor(true)
	dialog(Char_Robert;Robert;C1_Trial_Testimony5_Press3_47)

	:setCourtroomCamToJudge()
	dialog(Char_Judge;Judge;C1_Trial_Testimony5_Press3_48)

	showEvidenceInfo(C1_DeathMessage;Right)
	:setCourtroomCamToProsecutorImmediate()
	dialog(Char_Robert;Robert;C1_Trial_Testimony5_Press3_49)

	:setGeraldEyeSurprise(NoCoat)
	:setCourtroomCamToWitnessImmediate()
	dialog(Char_Gerald;GeraldNoCoat;C1_Trial_Testimony5_Press3_50)

	:setCourtroomCamToProsecutorImmediate()
	dialog(Char_Robert;Robert;C1_Trial_Testimony5_Press3_51)

	:setCourtroomCamToDefenseImmediate()
	dialog(Char_Rann;RannCoat;C1_Trial_Testimony5_Press3_52)
	showDialogWindow(false)

	:setGeraldEyeNormal(NoCoat)
	dialog(Char_Gerald;GeraldNoCoat;C1_Trial_Testimony5_Press3_53)
	dialog(Char_Gerald;GeraldNoCoat;C1_Trial_Testimony5_Press3_54)

	load(Testimony5End)

case Profile/C1_Juno:
	dialog(Char_Rann;RannCoat;C1_Trial_Testimony5_Press3_IncriminateJuno_1)
	showDialogWindow(false)

	:setRobertEyeThinking()
	:setCourtroomCamToProsecutor(true)
	dialog(Char_Robert;null;C1_Trial_Testimony5_Press3_IncriminateJuno_2)
	
	:setRobertEyeNormal()
	dialog(Char_Robert;Robert;C1_Trial_Testimony5_Press3_IncriminateJuno_3)
	showDialogWindow(false)

	:setRannStress(Coat)
	:setRannEyeOops(Coat)
	:setCourtroomCamToDefense(true)
	dialog(Char_Rann;RannCoat;C1_Trial_Testimony5_Press3_IncriminateJuno_4)
	dialog(Char_Rann;RannCoat;C1_Trial_Testimony5_Press3_IncriminateJuno_5)


	showLifeBarUI(true)
	setLifeBarUIPreviewRange(1;true;true)

	:setJudgeEyeAngry()
	:setCourtroomCamToJudge()
	if(C1_AttackedJuno == 1)
		dialog(Char_Judge;Judge;C1_Trial_Testimony5_Press3_IncriminateJuno_6)
	endif
	dialog(Char_Judge;Judge;C1_Trial_Testimony5_Press3_IncriminateJuno_7)

	:setCourtroomCamToDefenseImmediate()
	dialog(Char_Rann;RannCoat;C1_Trial_Testimony5_Press3_IncriminateJuno_8)

	:setCourtroomCamToJudge()
	if(C1_AttackedJuno == 1)
		dialog(Char_Judge;Judge;C1_Trial_Testimony5_Press3_IncriminateJuno_9)
	endif
	
	playSFX(LoseLife)
	screenshake(0.1;0.25;true;true)
	:removeHealth(1)
	setLifeBarUIPreviewRange(0;false;false)
	refreshLifeBarUI(false;true)

	dialog(Char_Judge;Judge;C1_Trial_Testimony5_Press3_IncriminateJuno_10)

	showLifeBarUI(false)

	if(C1_AttackedJuno == 1)
		variable(C1_AttackedJuno;=;2)
	endif

	if(LifePoints <= 0)
		load(../Common/Death)
	else
		:setJudgeEyeNormal()
		:setCourtroomCamToDefenseImmediate()
		dialog(Char_Rann;RannCoat;C1_Trial_Testimony5_Press3_IncriminateJuno_11)

		load(Testimony5Question)
	endif

case default:
	:setRannStress(Coat)
	:setRannEyeOops(Coat)
	dialog(Char_Rann;RannCoat;C1_Trial_Testimony5_Press3_IncriminateFail_1)

	:setCourtroomCamToJudge()
	dialog(Char_Judge;null;C1_Trial_Testimony5_Press3_IncriminateFail_2)
	
	:setCourtroomCamToProsecutorImmediate()
	dialog(Char_Robert;null;C1_Trial_Testimony5_Press3_IncriminateFail_3)

	:setCourtroomCamToDefenseImmediate()
	dialog(Char_Rann;RannCoat;C1_Trial_Testimony5_Press3_IncriminateFail_4)

	load(Testimony5Question)
endask