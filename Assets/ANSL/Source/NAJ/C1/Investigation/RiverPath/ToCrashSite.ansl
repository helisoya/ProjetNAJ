if(C1_AxeProgress == 2)

	dialog(Char_Rann;null;C1_River_Tree_After_1)
	dialog(Char_Rann;null;C1_River_Tree_After_2)

	fadeBg(1;true)

	dialog(null;null;C1_River_Tree_After_3)
	dialog(null;null;C1_River_Tree_After_4)

	fadeFg(1;true)
	setBg(0)
	showDialogWindow(false)

	load(../CrashSite/Arrival)

else

	dialog(Char_Rann;null;C1_River_Tree_Before_1)
	dialog(Char_Rann;null;C1_River_Tree_Before_2)
	dialog(Char_Rann;null;C1_River_Tree_Before_3)

	variable(C1_AxeProgress;=;1)
	load(Interaction)
endif