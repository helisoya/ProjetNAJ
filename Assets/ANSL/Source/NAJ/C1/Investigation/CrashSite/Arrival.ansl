clearStack()
setFg(1)

setBackground(C1/CrashSite)

fadeFg(0;false)

dialog(Char_Rann;null;C1_Investigation_End_1)
dialog(null;null;C1_Investigation_End_2)
dialog(null;null;C1_Investigation_End_3)
dialog(Char_Rann;null;C1_Investigation_End_4)


# Walk to side of ship, looking at it
setCameraPosition(-30;1.5;29;5;false)
setCameraRotation(-20;40;0;5;false)

dialog(null;null;C1_Investigation_End_5)
dialog(null;null;C1_Investigation_End_6)
dialog(null;null;C1_Investigation_End_7)

dialog(Char_Rann;null;C1_Investigation_End_8)
dialog(Char_Rann;null;C1_Investigation_End_9)
dialog(Char_Rann;null;C1_Investigation_End_10)
showDialogWindow(false)

# Looks around

setCameraRotation(0;60;0;2;true)
wait(1)
setCameraRotation(0;-15;0;3;true)

dialog(null;null;C1_Investigation_End_11)
showDialogWindow(false)

# Spot the captain

setCameraPosition(-30;1.5;30;0.5;false)
setCameraRotation(0;5;0;0.5;true)

dialog(null;null;C1_Investigation_End_12)
dialog(null;null;C1_Investigation_End_13)
dialog(Char_Rann;null;C1_Investigation_End_14)
dialog(null;null;C1_Investigation_End_15)
showDialogWindow(false)

# Walk to him

setCameraRotation(0;-6;0;3;false)
setCameraPosition(-27;1;50;3;true)

dialog(Char_Rann;null;C1_Investigation_End_16)
showDialogWindow(false)

# Spots the knife

setCameraRotation(28;-20;0;1;false)
setCameraPosition(-26;1;57.5;1;true)

dialog(null;null;C1_Investigation_End_17)
dialog(null;null;C1_Investigation_End_18)
showDialogWindow(false)

setCameraRotation(39;-40;0;1;false)
setCameraPosition(-29;-0.5;62;1;true)


load(Interaction)