clearStack()
setFg(1)

setBackground(C1_CrashSite)

addCharacter(Sartt;false;Captain)
:setSarttDead()

fadeFg(0;false)

wait(2)

# Walk to side of ship, looking at it
setCameraPosition(-30;1.5;29;4;false)
setCameraRotation(-20;40;0;4;true)

wait(2)

# Looks around

setCameraRotation(0;60;0;2;true)
wait(1)
setCameraRotation(0;-15;0;3;true)

wait(2)

# Spot the captain

setCameraPosition(-30;1.5;30;0.5;false)
setCameraRotation(0;5;0;0.5;true)

# Walk to him

setCameraRotation(0;-6;0;3;false)
setCameraPosition(-27;1;50;3;true)

# Spots the knife

wait(1)

setCameraRotation(28;-20;0;1;false)
setCameraPosition(-26;1;57.5;1;true)


# White Man Screamer

wait(2)

addCharacter(Robert;false;Sherif)
:setRobertAimingGun()

setCameraRotation(-5;128;0;1;true)

