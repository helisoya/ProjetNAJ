switch(C1_AxeProgress)
case 0:
	# Before being able to retreive it
	dialog(Char_Rann;null;C1_DeadEnd_Owl_Before_1)
	playSFX(Owl)
	dialog(null;null;C1_DeadEnd_Owl_Before_2)
	dialog(Char_Rann;null;C1_DeadEnd_Owl_Before_3)
	dialog(Char_Rann;null;C1_DeadEnd_Owl_Before_4)
	dialog(Char_Rann;null;C1_DeadEnd_Owl_Before_5)
	playSFX(Owl)
	dialog(null;null;C1_DeadEnd_Owl_Before_6)
	dialog(Char_Rann;null;C1_DeadEnd_Owl_Before_7)
case 1:
	# After being able to retreive it
	dialog(Char_Rann;null;C1_DeadEnd_Owl_After_1)
	playSFX(Owl)
	dialog(null;null;C1_DeadEnd_Owl_After_2)
	dialog(null;null;C1_DeadEnd_Owl_After_3)
	playSFX(BirdFly)
	setCharacterBody(Owl;FlyOffScreen)
	wait(2)
	dialog(Char_Rann;null;C1_DeadEnd_Owl_After_4)
	dialog(Char_Rann;null;C1_DeadEnd_Owl_After_5)

	setStaticAlpha(Axe;0;0.5;true)
	setStaticPosition(Axe;0;0;-50)

	addEvidence(C1_Axe)

	playSFX(EvidenceInfo)
	fadeBg(0.75;false)
	showEvidenceInfo(Evidence/C1_AutopsyReport;Full)
	dialog(null;null;C1_Investigation_Evidence_Axe_1)
	hideEvidenceInfo()
	fadeBg(0.0;false)

	dialog(Char_Rann;null;C1_DeadEnd_Owl_After_6)
	dialog(Char_Rann;null;C1_DeadEnd_Owl_After_7)
	dialog(Char_Rann;null;C1_DeadEnd_Owl_After_8)
	dialog(Char_Rann;null;C1_DeadEnd_Owl_After_9)

	variable(C1_AxeProgress;=;2)
endswitch


load(Interaction)