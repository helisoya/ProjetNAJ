clearStack()
setFg(1)

:setBackgroundWithLoading(C1/SecretCave;true)
setSkybox(Day)
setAmbientIntensity(0.5)

if(C1_SecretElk != 2)
	setStaticHidden(DoorPiece;true)
	playAmbient(Wind)
	playAmbient(SpookyCave)
else
	removeStatic(Door)
	removeCharacter(Elk)
	playAmbient(SpookyCaveEmpty)
endif

fadeFg(0;false)

load(Interaction)