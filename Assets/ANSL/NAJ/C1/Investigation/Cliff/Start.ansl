setBackground(C1_Cliff)

# On Ground
setCameraPosition(0;-2;-3)
setCameraRotation(-70;28;0)

fadeFg(0;false)

wait(2)

# Get up
setCameraRotation(15;28;0;2;true)

wait(2)

# Get full up
setCameraRotation(15;21;0;2;false)
setCameraPosition(0;1;-4;2;true)

wait(2)

# Look Around
setCameraRotation(10;-5;0;2;true)

wait(2)

# Look at ship
setCameraRotation(0;-70;0;2;false)
setCameraPosition(default;2;true)

wait(2)

# Look at trail

setCameraRotation(0;30;0;2;true)

wait(2)

setCameraRotation(0;0;0;2;true)

load(Interaction)