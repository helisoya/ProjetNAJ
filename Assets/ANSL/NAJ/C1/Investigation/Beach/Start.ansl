setBackground(C1_Beach)

setCameraPosition(0;-4;-15)
setCameraRotation(-80;200;0)

fadeFg(0;false)

# Wake up
wait(2)

setCameraRotation(-8;200;0;1;true)

wait(2)

# Get up
setCameraPosition(0;0;-15;1;true)

wait(2)

# Look around

setCameraRotation(0;100;0;1;true)
wait(1)
setCameraRotation(0;360;0;3;true)

wait(2)

# Walk to default pos

setCameraPosition(default;2;true)
setCameraRotation(0;0;0)

load(Interaction)