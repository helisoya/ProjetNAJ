<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Assets/UIToolkit/MapEditor/MapEditorWindow.uss?fileID=7433441132597879392&amp;guid=2fe444ac00a165d4d9882346d44c1828&amp;type=3#MapEditorWindow"/>
    <ui:VisualElement name="VisualElement" style="flex-grow: 1; flex-direction: row;">
        <ui:VisualElement style="flex-grow: 1; min-width: 10%; max-width: 20%;">
            <ui:ScrollView name="ScrollViewMaps" style="position: relative; height: 100%; width: 100%; top: auto; left: auto; background-color: rgb(0, 0, 0);"/>
        </ui:VisualElement>
        <ui:VisualElement style="flex-grow: 1;">
            <ui:VisualElement style="flex-grow: 1;">
                <ui:VisualElement name="VisualElement" style="flex-grow: 1; flex-direction: row;">
                    <ui:VisualElement style="flex-grow: 1; align-items: stretch; justify-content: center;">
                        <ui:TextField label="Map ID" placeholder-text="Enter Map ID" name="MapIDTextField" style="position: relative; top: auto; left: auto; height: auto; width: 90%; min-width: 90%; max-width: 90%;"/>
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-grow: 1; justify-content: center; align-items: flex-start;">
                        <ui:Button text="New Map" name="NewMap" style="position: relative; top: auto; left: auto; width: 91px; height: 23px; justify-content: center; align-content: center;"/>
                        <ui:Button text="New Button&#10;" name="NewButton" style="position: relative; top: auto; left: auto; width: 93px; height: 23px; justify-content: center; align-content: center;"/>
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-grow: 1; align-items: flex-end; justify-content: center;">
                        <ui:Button text="Save&#10;" name="SaveButton" style="position: relative; top: auto; left: auto; width: 53px; height: 23px; align-content: center; justify-content: center;"/>
                        <ui:Button text="Remove" name="RemoveButton" style="position: relative; top: auto; left: auto; width: 64px; height: 23px; justify-content: center; align-content: center;"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement style="flex-grow: 1; height: 5px; min-height: 5px; max-height: 5px;">
                    <ui:Image source="project://database/Resources/unity_builtin_extra?fileID=10305&amp;guid=0000000000000000f000000000000000&amp;type=0#Default-Checker" scale-mode="StretchToFill" style="top: auto; height: 100%; width: 100%;"/>
                </ui:VisualElement>
                <ui:VisualElement style="flex-grow: 1; flex-shrink: 1; flex-basis: auto; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; min-height: 30%; max-height: 50%;">
                    <ui:VisualElement name="ButtonInfoRoot" style="flex-grow: 1; position: relative; height: 100%; width: 100%; top: auto; left: auto; flex-direction: row;">
                        <ui:VisualElement style="flex-grow: 1; flex-direction: column; margin-right: 0; align-items: flex-start;">
                            <ui:VisualElement style="flex-grow: 1; width: 100%; height: 34px; min-height: 34px; min-width: 100%;">
                                <ui:TextField label="Button ID" placeholder-text="Enter Button ID" name="ButtonIDTextField" style="position: relative; top: auto; left: auto; height: 34px; width: 90%; min-width: 90%; max-width: 90%; flex-wrap: wrap; white-space: normal;"/>
                            </ui:VisualElement>
                            <ui:Slider label="X" value="0.5" high-value="1" name="XSlider" style="position: relative; top: auto; left: auto; width: 90%;"/>
                            <ui:Slider label="Y" value="0.5" high-value="1" name="YSlider" style="position: relative; top: auto; left: auto; width: 90%;"/>
                        </ui:VisualElement>
                        <ui:VisualElement style="flex-grow: 1; flex-direction: column; justify-content: flex-start; align-items: flex-start;">
                            <ui:Button text="Rename" name="RenameButton" style="min-width: auto; max-width: none;"/>
                            <ui:Slider label="Rotation" value="0" high-value="360" name="RotationSlider" style="position: relative; top: auto; left: auto; width: 90%;"/>
                            <uie:ObjectField label="Sprite" value="" name="ButtonSpriteField"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement style="flex-grow: 1; min-height: 30%; max-height: 60%; flex-direction: column; flex-wrap: nowrap; -unity-text-align: upper-left; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; align-items: center; justify-content: flex-end;">
                <ui:Image source="project://database/Assets/Sprites/Paintings/3.png?fileID=2800000&amp;guid=189b91015af8ee548a5ff9539fb8f59f&amp;type=3#3" scale-mode="ScaleToFit" uv="0,0,1,1" name="BackgroundImg" style="opacity: 1; left: auto; height: 100%; width: 100%; position: relative; top: auto; aspect-ratio: 1.777778; right: auto; bottom: auto; justify-content: flex-start; align-items: stretch; align-content: flex-start; flex-direction: column; flex-wrap: nowrap; flex-shrink: 1; flex-grow: 0; flex-basis: 100%; align-self: auto; transform-origin: center; min-width: 100%; max-width: 100%; min-height: 100%; max-height: 100%;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement style="flex-grow: 1; left: auto; right: auto; width: initial; min-width: 10%; max-width: 20%;">
            <ui:ScrollView name="ScrollViewButtons" style="position: relative; height: 100%; width: 100%; top: auto; left: auto; background-color: rgb(0, 0, 0);"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
